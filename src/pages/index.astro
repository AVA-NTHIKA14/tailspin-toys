---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const database = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(database),
  getAllCategories(database),
  getAllPublishers(database),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex flex-col gap-4 mb-6 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        <p class="text-sm text-slate-400" data-testid="games-count" aria-live="polite">
          Showing {games.length} {games.length === 1 ? 'game' : 'games'}
        </p>
      </div>

      {games.length > 0 && (
        <form class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" data-testid="game-filters">
          <div class="grid gap-6 md:grid-cols-[2fr_1fr]">
            <fieldset>
              <legend class="mb-3 text-sm font-semibold text-slate-200">Filter by category</legend>
              <div class="flex flex-wrap gap-3">
                {categories.map((category) => (
                  <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-300 transition-colors hover:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500">
                    <input
                      type="checkbox"
                      name="category"
                      value={category.id}
                      class="h-4 w-4 accent-blue-500"
                      data-testid={`category-filter-${category.id}`}
                    />
                    <span>{category.name}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <div>
              <label for="publisher-filter" class="mb-3 block text-sm font-semibold text-slate-200">
                Filter by publisher
              </label>
              <select
                id="publisher-filter"
                name="publisher"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
                data-testid="publisher-filter"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                  <option value={publisher.id}>{publisher.name}</option>
                ))}
              </select>
            </div>
          </div>
          <button
            type="reset"
            class="mt-5 rounded-lg border border-slate-600 px-4 py-2 text-sm text-slate-300 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="clear-filters"
          >
            Clear filters
          </button>
        </form>
      )}

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
      {games.length > 0 && (
        <div class="hidden" data-testid="filtered-empty-state">
          <EmptyState text="No games match the selected filters." />
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const gamesCount = document.querySelector<HTMLElement>('[data-testid="games-count"]');
  const filteredEmptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');

  function applyFilters(): void {
    if (!filterForm || !gamesCount || !filteredEmptyState) return;

    const selectedCategories = new Set(
      Array.from(filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]:checked'))
        .map((input) => input.value),
    );
    const selectedPublisher = filterForm.querySelector<HTMLSelectElement>('[name="publisher"]')?.value ?? '';
    let visibleGames = 0;

    gameCards.forEach((card) => {
      const categoryMatches =
        selectedCategories.size === 0 || selectedCategories.has(card.dataset.gameCategoryId ?? '');
      const publisherMatches =
        selectedPublisher === '' || selectedPublisher === card.dataset.gamePublisherId;
      const visible = categoryMatches && publisherMatches;
      card.hidden = !visible;
      if (visible) visibleGames += 1;
    });

    gamesCount.textContent = `Showing ${visibleGames} ${visibleGames === 1 ? 'game' : 'games'}`;
    filteredEmptyState.classList.toggle('hidden', visibleGames > 0);
  }

  filterForm?.addEventListener('change', applyFilters);
  filterForm?.addEventListener('reset', () => requestAnimationFrame(applyFilters));
</script>
